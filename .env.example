# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# Authentication: clang-auth (https://auth.clintonlangosch.com)
# Local dev uses a local clang-auth and the localtest.me domain, so cookies are
# shared: open http://lexicon.localtest.me:8888 (not localhost). See docs/PLAN.md.
AUTH_BASE_URL=http://auth.localtest.me:4000
NEXT_PUBLIC_AUTH_BASE_URL=http://auth.localtest.me:4000
AUTH_APP_SLUG=lexicon
APP_ORIGIN=http://lexicon.localtest.me:8888

# Anthropic API key
ANTHROPIC_API_KEY=

# External API for Author Images
AUTHOR_IMAGE_API_URL=https://api.example.com/images
AUTHOR_IMAGE_API_KEY=your-api-key-if-needed

# Definition API Configuration
DEFINITION_API_PROVIDER=free-dictionary
# MERRIAM_WEBSTER_API_KEY=your-api-key-here  # Uncomment if using Merriam-Webster

# Definition Update Configuration
DEF_BATCH_SIZE=50
DEF_RATE_LIMIT_MS=1000
DEF_MAX_REQUESTS=100
DEF_RETRY_NOT_FOUND_DAYS=90
DEF_RETRY_ERROR_DAYS=7
